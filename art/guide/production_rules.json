{
  "guide_version": "1.0.0",
  "snapshot_date": "2026-10-29",
  "default_working_theme": "A",
  "default_is_final_user_selection": false,
  "scope": "2D garden raster assets and matching native UI",
  "precedence": ["explicit_current_user_request", "original_reference_images", "theme_profile", "common_rules", "new_content"],
  "reference_policy": {
    "manifest": "reference_manifest.json",
    "preserve_originals": true,
    "inspect_before_use": true,
    "verify_hashes_before_batch": true,
    "attach_relevant_originals_every_generation": true,
    "new_generation_must_not_be_only_reference": true,
    "typical_reference_count": [2, 3]
  },
  "character": {
    "identity_master": "references/character_master.png",
    "pose_reference": "references/character_poses.png",
    "leaf_count": 2,
    "body": "round cream head joined to a tiny plump torso, no long neck",
    "arms": "very short cream mitten arms",
    "feet": "two stubby green feet",
    "eyes": "two small vertical black eyes in front view",
    "mouth": "small orange U smile",
    "cheeks": "peach",
    "arm_exposed_length_target_max_face_width_ratio": 0.25,
    "ratio_is_forward_production_target": true,
    "unrequested_features_forbidden": ["extra_leaves", "extra_limbs", "long_human_arms", "five_fingers", "nose", "ears", "eyelashes", "clothing"]
  },
  "common_style": {
    "medium": "warm calm 2D pixel-painted game art",
    "camera": "match elevated three-quarter reference camera; no invented numeric angle",
    "light": "soft daylight, upper-left lit surfaces, short lower-right contact shadows",
    "edges": "readable pixel clusters and dark warm outlines",
    "detail": "broad quiet ground shapes, sparse fine texture",
    "materials": ["honey_brown_wood", "warm_beige_stone", "cream_canvas", "sage_foliage"],
    "forbidden_unless_requested": ["photorealism", "3D_plastic_toy_render", "glossy_materials", "neon_colors", "hard_bloom", "heavy_depth_of_field", "dense_multicolor_flower_confetti", "random_stippling", "text", "UI", "watermarks", "phone_frames"]
  },
  "palette": {
    "note": "Character samples are approximate 8-level RGB quantized source samples. Environmental colors are production targets, not extracted exact masters.",
    "character_cream": {"hex": "#F8F0D0", "kind": "approximate_character_sample"},
    "character_leaf": {"hex": "#78B030", "kind": "approximate_character_sample"},
    "character_cheek": {"hex": "#F8B090", "kind": "approximate_character_sample"},
    "character_warm_shade": {"hex": "#F8D888", "kind": "approximate_character_sample"},
    "dark_outline": {"hex": "#181000", "kind": "approximate_character_sample"},
    "sage_ground": {"hex": "#A6B36B", "kind": "environment_target"},
    "deep_foliage": {"hex": "#4D6D3A", "kind": "environment_target"},
    "honey_wood": {"hex": "#B57938", "kind": "environment_target"},
    "warm_stone": {"hex": "#CEC2A1", "kind": "environment_target"},
    "still_water": {"hex": "#437B73", "kind": "environment_target"},
    "canvas_cream": {"hex": "#F2E6C7", "kind": "environment_target"},
    "ui_paper": {"hex": "#FFF9ED", "kind": "native_ui_target"}
  },
  "themes": {
    "A": {
      "name": "나무 그늘 마당",
      "scene": "references/theme_a_decorated.png",
      "empty_background": "references/theme_a_empty.png",
      "props": "references/theme_a_props.png",
      "locked_layout": ["sage_round_roof_cottage_upper_right", "large_tree_left", "central_lawn", "curved_path_from_bottom_to_cottage"],
      "excluded": ["river", "waterfall", "bridge", "greenhouse", "long_veranda"]
    },
    "B": {
      "name": "연못과 툇마루",
      "scene": "references/theme_b_decorated.png",
      "empty_background": "references/theme_b_empty.png",
      "props": "references/theme_b_props.png",
      "locked_layout": ["low_cottage_and_veranda_at_top", "pond_left", "central_lawn", "curved_path_right"],
      "excluded": ["river", "waterfall", "bridge", "greenhouse"]
    },
    "C": {
      "name": "숲속 온실",
      "scene": "references/theme_c_decorated.png",
      "empty_background": "references/theme_c_empty.png",
      "props": "references/theme_c_props.png",
      "locked_layout": ["greenhouse_upper_right", "pergola_upper_left", "central_gravel", "stepping_stones_from_bottom"],
      "excluded": ["residential_cottage", "pond", "river", "waterfall"]
    }
  },
  "composition_targets": {
    "values_are_forward_guidance_not_measured_source_statistics": true,
    "connected_open_central_ground_fraction": [0.35, 0.45],
    "default_decorated_example_prop_groups": 6,
    "starting_small_flower_clusters": [2, 3],
    "keep_paths_and_doorways_clear": true,
    "more_inventory_does_not_mean_more_items_in_one_scene": true
  },
  "file_contract": {
    "background_reference_size": [1672, 941],
    "background_aspect": "approximately 16:9",
    "record_actual_output_dimensions": true,
    "sprites": "RGBA PNG with actual transparent alpha and visible foreground",
    "prop_sheet_default_grid": {"columns": 3, "rows": 2, "item_count": 6},
    "uniform_canvas_within_batch": true,
    "minimum_export_padding_pixels": 12,
    "padding_is_export_requirement_not_raw_generation_guarantee": true,
    "sprite_default_anchor": "bottom_center; actual ground contact verified visually",
    "current_packed_prop_canvas": {"A": [608, 432], "B": [512, 480], "C": [544, 400]},
    "filename_pattern": "{theme_lower}_{asset_type}_{subject}_v{version_3_digits}.png",
    "never_overwrite_master": true,
    "new_assets_destination": "deliveries/{theme_lower}_{subject}_v{version_3_digits}/"
  },
  "review": {
    "hard_failures": ["character_identity_changed", "theme_layout_changed_without_request", "unrequested_text_or_UI", "fake_transparency", "clipped_content", "unreadable_file", "merged_sheet_cells"],
    "scored_dimensions": ["shape", "palette_and_value", "camera_and_light", "pixel_cluster_rendering", "composition_and_small_size_readability"],
    "score_per_dimension": [0, 1, 2],
    "minimum_total": 9,
    "zero_dimension_allowed": false,
    "score_is_subjective_visual_review": true,
    "not_a_user_approval_gate": true
  }
}
